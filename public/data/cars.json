    { "id": "porsche_911_gt3_rs", "brand": "Porsche", "name": "911 GT3 RS", "type": "car", "modelUrl": "/models/cars/porsche_911_gt3_rs.glb", "thumbnails": ["https://images.unsplash.com/photo-1614162692292-7ac56d7f7f1e?w=600"], "specs": { "engine": "4.0L Flat-6", "power": "518 hp", "0_60": "3.0s", "top_speed": "184 mph", "downforce": "1,895 lbs" }, "library": { "prototype_year": "2022", "designer": "Andreas Preuninger", "origin": "Stuttgart, Germany", "tire_type": "Michelin Pilot Sport Cup 2 R", "history": "The 992-generation Porsche 911 GT3 RS is the most extreme naturally aspirated 911 ever built for public roads. It introduced active aerodynamics borrowed from Formula 1, including a Drag Reduction System (DRS). Its central radiator concept, replacing the traditional three-radiator setup, freed up space for massive active aero flaps in the front bumper."} },
    { "id": "porsche_taycan", "brand": "Porsche", "name": "Taycan Turbo S", "type": "car", "modelUrl": "/models/cars/porsche_taycan.glb", "thumbnails": ["https://images.unsplash.com/photo-1614200179396-2bdb77bc3e15?w=600"], "specs": { "engine": "Dual Electric Motor", "power": "750 hp", "0_60": "2.6s", "top_speed": "161 mph", "downforce": "Low" }, "library": { "prototype_year": "2019", "designer": "Michael Mauer", "origin": "Stuttgart, Germany", "tire_type": "Pirelli P Zero", "history": "Porsche's first fully electric sports car. Developed from the Mission E concept, it utilizes an innovative 800-volt architecture for ultra-fast charging and consistent performance without thermal throttling."} },
    { "id": "mclaren_p1", "brand": "McLaren", "name": "P1", "type": "car", "modelUrl": "/models/cars/mclaren_p1.glb", "thumbnails": ["https://images.unsplash.com/photo-1621648074902-601e7498c8dc?w=600"], "specs": { "engine": "3.8L V8 Hybrid", "power": "903 hp", "0_60": "2.7s", "top_speed": "217 mph", "downforce": "1,323 lbs" }, "library": { "prototype_year": "2012", "designer": "Frank Stephenson", "origin": "Woking, England", "tire_type": "Pirelli P Zero Corsa", "history": "Part of the legendary 'Holy Trinity' of hypercars alongside the LaFerrari and Porsche 918 Spyder. The P1 redefined the integration of hybrid technology for sheer performance, utilizing an electric motor to fill the torque gap of its massive twin turbos."} },
    { "id": "ferrari_f40", "brand": "Ferrari", "name": "F40", "type": "car", "modelUrl": "/models/cars/ferrari_f40.glb", "thumbnails": ["https://images.unsplash.com/photo-1583121274602-3e2820c69888?w=600"], "specs": { "engine": "2.9L Twin-Turbo V8", "power": "471 hp", "0_60": "4.2s", "top_speed": "201 mph", "downforce": "Moderate" }, "library": { "prototype_year": "1987", "designer": "Pininfarina (Leonardo Fioravanti)", "origin": "Maranello, Italy", "tire_type": "Pirelli P Zero", "history": "The last Ferrari personally approved by Enzo Ferrari. Built to celebrate the brand's 40th anniversary, it was the first production car to break the 200 mph barrier, featuring a kevlar, carbon fiber, and aluminum body for extreme lightness."} },
    { "id": "bugatti_chiron", "brand": "Bugatti", "name": "Chiron Super Sport", "type": "car", "modelUrl": "/models/cars/bugatti_chiron.glb", "thumbnails": ["https://images.unsplash.com/photo-1627454820516-dc76717a0279?w=600"], "specs": { "engine": "8.0L Quad-Turbo W16", "power": "1,578 hp", "0_60": "2.3s", "top_speed": "273 mph", "downforce": "Variable" }, "library": { "prototype_year": "2016", "designer": "Achim Anscheidt", "origin": "Molsheim, France", "tire_type": "Michelin Pilot Sport Cup 2", "history": "The Chiron Super Sport is an engineering marvel designed to bend physics. It famously broke the 300 mph barrier, utilizing a monstrous W16 engine and cooling systems that cycle hundreds of liters of water per minute."} },
    { "id": "mercedes_amg_gt", "brand": "Mercedes", "name": "AMG GT Black Series", "type": "car", "modelUrl": "/models/cars/mercedes_amg_gt.glb", "thumbnails": ["https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?w=600"], "specs": { "engine": "4.0L Twin-Turbo V8", "power": "720 hp", "0_60": "3.1s", "top_speed": "202 mph", "downforce": "882 lbs" }, "library": { "prototype_year": "2020", "designer": "Gorden Wagener", "origin": "Affalterbach, Germany", "tire_type": "Michelin Pilot Sport Cup 2 R", "history": "The absolute pinnacle of AMG engineering. It utilizes a flat-plane crank V8 and features aggressive aerodynamics directly derived from the AMG GT3 race car, briefly holding the Nürburgring lap record."} },
    { "id": "f1_rb19", "brand": "Formula 1", "name": "Red Bull RB19 (2023)", "type": "f1", "modelUrl": "", "thumbnails": ["https://images.unsplash.com/photo-1681283624838-51f72cf0db8e?w=600"], "specs": { "engine": "Honda RBPTH001 1.6L V6 Turbo", "power": "1000+ hp", "0_60": "2.1s", "top_speed": "220 mph", "driven_by": "Max Verstappen" }, "library": { "season": "2023", "driver": "Max Verstappen", "driver_age": "26", "chassis": "RB19", "engine": "Honda RBPTH001", "tires": "Pirelli", "poles": "14", "wins": "21 (Team)", "podiums": "30 (Team)", "history": "The RB19 is statistically the most dominant car in Formula 1 history, winning 21 out of 22 races in the 2023 season. Designed by Adrian Newey, its ground-effect aerodynamics and suspension were unmatched." } },
    { "id": "f1_w11", "brand": "Formula 1", "name": "Mercedes W11 (2020)", "type": "f1", "modelUrl": "", "thumbnails": ["https://images.unsplash.com/photo-1590848039750-61b7fcf76eb2?w=600"], "specs": { "engine": "Mercedes M11 EQ Performance", "power": "1000+ hp", "0_60": "2.0s", "top_speed": "220 mph", "driven_by": "Lewis Hamilton" }, "library": { "season": "2020", "driver": "Lewis Hamilton", "driver_age": "35", "chassis": "W11", "engine": "Mercedes M11", "tires": "Pirelli", "poles": "15", "wins": "13", "podiums": "25", "history": "Regarded as the fastest F1 car ever built due to the 2020 regulations. It featured the revolutionary DAS (Dual Axis Steering) system and set track records across the globe." } },
